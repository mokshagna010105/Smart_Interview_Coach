# Backend Environment Configuration Template
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/interview_ai

# JWT Secrets (Minimum 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long

# AI Provider (Optional: Falls back to deterministic generator/evaluator if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# SMTP Email Configuration (Optional: Falls back to console logger if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="InterviewAI" <no-reply@interviewai.com>

# Client URL & Storage
FRONTEND_URL=http://localhost:5173
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
