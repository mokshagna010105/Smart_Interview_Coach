NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/interview_ai

JWT_ACCESS_SECRET=dev_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
SPEECH_PROVIDER=web_speech
