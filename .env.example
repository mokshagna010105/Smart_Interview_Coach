# ============================================================
# SMART INTERVIEW COACH (InterviewAI) - Environment Configuration
# ============================================================

# Backend Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/interview_ai

# Authentication & Security
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Service (Google Gemini API)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Storage Provider (local | s3 | cloudinary)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# Speech Provider (web_speech | whisper)
SPEECH_PROVIDER=web_speech

# Email Service (Optional for Password Reset)
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@interviewai.local
